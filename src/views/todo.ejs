<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Todo List - SaaS API</title>
  <link href="/css/base.css" rel="stylesheet" />
  <style>
    nav {
      margin-bottom: 20px;
      padding: 10px 0;
      border-bottom: 1px solid #ddd;
    }

    nav a {
      margin-right: 16px;
      text-decoration: none;
      color: #333;
      font-weight: bold;
      font-family: monospace;
    }

    nav a:hover {
      text-decoration: underline;
    }

    nav a.active {
      border-bottom: 2px solid #333;
    }
  </style>
</head>

<body>
  <nav>
    <a href="/">Home</a>
    <a href="/auth">Auth</a>
    <a href="/todo" class="active">Todo List</a>
    <a href="/dsa">DSA</a>
  </nav>

  <h2>Manajemen Todo</h2>

  <div class="container">
    <div class="left-panel">
      <div class="panel">
        <div class="base-url">
          <label>Base URL API</label>
          <input id="baseUrl" />
        </div>
        <fieldset>
          <legend>Daftar Todo</legend>
          <div id="todo-list">

          </div>
          <div style="display: flex; gap: 8px; align-items: center">
            <button onclick="loadTodo(currentPage - 1)" id="prev-btn" disabled>Prev</button>
            <span id="page-info" style="font-size: 13px">1 / 1</span>
            <button onclick="loadTodo(currentPage + 1)" id="next-btn" disabled>Next</button>
          </div>
        </fieldset>

        <fieldset>
          <legend>Buat Todo</legend>
          <label>Nama Todo</label>
          <input id="name" />
          <button onclick="createTodo()">Buat Todo</button>
        </fieldset>
      </div>
    </div>

    <div class="right-panel">
      <div class="panel">
        <div class="response-header">
          <h3>Response Terakhir</h3>
        </div>
        <p class="status" id="status">Belum ada request</p>
        <div class="response-container">
          <pre id="output">(belum ada request)</pre>
        </div>
      </div>
    </div>
  </div>

  <script>window.API_BASE_URL = window.location.origin;</script>

  <div id="toast-container"></div>
  <script src="/js/api.js"></script>
  <script src="/js/todo.js"></script>
</body>

</html>